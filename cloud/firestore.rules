rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function email() { return request.auth.token.email.lower(); }
    // Replaced only in a private deployment copy by scripts/prepare-cloud.mjs.
    function bootstrapOwner() { return googleUser() && email() == 'SET_OWNER_EMAIL_BEFORE_DEPLOYING'; }
    function memberPath(workspace) { return /databases/$(database)/documents/workspaces/$(workspace)/members/$(email()); }
    function member(workspace) { return googleUser() && exists(memberPath(workspace)); }
    function owner(workspace) { return member(workspace) && get(memberPath(workspace)).data.role == 'owner'; }
    function validText(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 150
        && d.sourceName is string && d.sourceName.size() <= 150
        && d.sourceStartDate is string && d.sourceStartDate.size() <= 10
        && d.version is int && d.version > 0 && d.deleted is bool;
    }
    function validCompany(d) {
      return validText(d) && d.keys().hasOnly(['name','category','mainKeyword','manager','contact','startDate','endDate','notes','existingEndDate','sourceName','sourceStartDate','version','deleted','createdAt','updatedAt'])
        && (!('endDate' in d) || (d.endDate is string && (d.endDate == '' || d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))))
        && (d.deleted == true || (
          d.category is string && d.category.size() <= 5000
          && d.mainKeyword is string && d.mainKeyword.size() <= 5000
          && d.manager is string && d.manager.size() <= 5000
          && d.contact is string && d.contact.size() <= 5000
          && d.notes is string && d.notes.size() <= 5000
          && d.existingEndDate is string && d.existingEndDate.size() <= 5000
          && d.startDate is string && (d.startDate == '' || d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        ));
    }
    match /workspaces/{workspace} {
      allow get: if member(workspace) || bootstrapOwner();
      allow create: if bootstrapOwner()
        && request.resource.data.keys().hasOnly(['ownerEmail','createdAt'])
        && request.resource.data.ownerEmail == email()
        && request.resource.data.createdAt == request.time;
      allow update, delete, list: if false;
      match /members/{account} {
        allow get: if googleUser() && (account == email() || owner(workspace));
        allow list: if owner(workspace);
        allow create: if googleUser()
          && request.resource.data.keys().hasOnly(['email','role','createdAt'])
          && request.resource.data.email == account && account == account.lower()
          && account.matches('^[^ /@]+@[^ /@]+[.][^ /@]+$')
          && request.resource.data.createdAt == request.time
          && ((owner(workspace) && request.resource.data.role == 'editor')
            || (bootstrapOwner() && account == email() && request.resource.data.role == 'owner'
              && !exists(/databases/$(database)/documents/workspaces/$(workspace))
              && getAfter(/databases/$(database)/documents/workspaces/$(workspace)).data.ownerEmail == email()));
        allow update: if false;
        allow delete: if owner(workspace) && resource.data.role == 'editor' && account != email();
        match /reads/{slot} {
          allow read: if member(workspace) && account == email();
          allow create, update: if member(workspace) && account == email()
            && request.resource.data.keys().hasOnly(['readAt']) && request.resource.data.readAt == request.time;
          allow delete: if false;
        }
      }
      match /companies/{company} {
        allow read: if member(workspace);
        allow create: if member(workspace) && validCompany(request.resource.data)
          && request.resource.data.version == 1 && request.resource.data.deleted == false
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if member(workspace) && !resource.data.deleted && validCompany(request.resource.data)
          && request.resource.data.version == resource.data.version + 1
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.sourceName == resource.data.sourceName
          && request.resource.data.sourceStartDate == resource.data.sourceStartDate;
        allow delete: if false;
      }
      match /notifications/{slot} {
        allow read: if member(workspace);
        allow create: if member(workspace)
          && request.resource.data.keys().hasOnly(['createdAt','companies'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.companies is list
          && request.resource.data.companies.size() > 0 && request.resource.data.companies.size() <= 49;
        allow update, delete: if false;
      }
    }
  }
}
